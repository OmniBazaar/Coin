{
  "name": "omnicoin-contracts",
  "version": "2.0.0",
  "license": "BUSL-1.1",
  "description": "OmniCoin + OmniBazaar smart contracts — XOM token, marketplace, DEX, privacy (COTI V2), and governance, deployed on the OmniCoin L1 (chain 88008) and remote chains",
  "author": "OmniBazaar",
  "repository": {
    "type": "git",
    "url": "git://github.com/OmniBazaar/Coin.git"
  },
  "keywords": [
    "omnicoin",
    "omnibazaar",
    "coti",
    "privacy",
    "ethereum",
    "blockchain",
    "web3",
    "defi",
    "marketplace"
  ],
  "scripts": {
    "compile": "nice -n 10 hardhat compile",
    "test": "hardhat test",
    "test:security": "hardhat test test/security/",
    "test:integration": "hardhat test test/integration/",
    "test:gas": "REPORT_GAS=true hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "verify": "hardhat verify --network",
    "verify:deployment": "node scripts/verify-deployment.js",
    "lint": "nice -n 10 solhint contracts/*.sol",
    "format": "prettier --write contracts/*.sol",
    "coverage": "hardhat coverage"
  },
  "devDependencies": {
    "@avalabs/avalanchejs": "^5.0.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "~5.3.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "hardhat": "^2.22.15",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.9",
    "jest": "^29.7.0",
    "merkletreejs": "^0.6.0",
    "prettier": "3.8.3",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^6.0.3",
    "solidity-coverage": "^0.8.5",
    "ts-jest": "^29.1.0",
    "typechain": "^8.3.2",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@coti-io/coti-contracts": "1.2.0",
    "@coti-io/coti-ethers": "1.0.5",
    "@coti-io/coti-sdk-typescript": "1.0.6",
    "@layerzerolabs/lz-evm-oapp-v2": "^3.0.167",
    "@layerzerolabs/lz-evm-protocol-v2": "^3.0.167",
    "@layerzerolabs/oapp-evm": "^0.4.1",
    "@layerzerolabs/oft-evm": "^4.0.1",
    "@openzeppelin/contracts": "^5.3.0",
    "ajv": "^8.20.0",
    "chai": "^4.5.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.0.0"
  },
  "bugs": {
    "url": "https://github.com/OmniBazaar/Coin/issues"
  },
  "overrides": {
    "_comment": "@noble/hashes scoped overrides 2026-05-16 — hardhat-internal ethereum-cryptography@2.2.1 + @scure/bip32 expect v1.4 API (`_assert.default.bool`, `_assert.bytes` named export); v1.8 renamed both (`abytes`, dropped `bool` + `default`). v1.4 satisfies both. Scoped per-package to avoid affecting unrelated v1.8 consumers (viem etc.).",
    "@scure/bip32": {
      "@noble/hashes": "1.4.0"
    },
    "ethereum-cryptography": {
      "@noble/hashes": "1.4.0"
    },
    "ethers": {
      "@noble/hashes": "1.4.0"
    },
    "hardhat": {
      "@noble/hashes": "1.4.0"
    }
  }
}
